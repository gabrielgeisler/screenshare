SENHA=123456

# DISCORD_BOT_TOKEN=TOKEN
# DISCORD_CHANNEL_ID=CHANNEL_ID

# Opcional: servidor TURN, necessário para espectadores atrás de NAT/firewall
# restritivo (STUN sozinho não é suficiente nesses casos). Ex.: Twilio, Metered, coturn próprio.
# TURN_URL=turn:seu-servidor-turn.com:3478
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha